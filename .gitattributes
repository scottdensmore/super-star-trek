# The golden fixtures are compared byte for byte, so a clone that
# rewrote their line endings would fail every journey.
c/tests/golden/*.txt -text

# Vintage C files (CRLF) and newer C files (LF)
c/*.c -text
c/*.h -text
c/tests/*.c -text
c/tests/*.sh -text
c/sst.doc -text

# Other shell scripts
*.sh -text

